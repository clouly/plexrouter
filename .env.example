# Copy to .env and adjust. All settings are optional.

# Listen address (default :8080)
# PLEXROUTER_ADDR=:8080
# Where the SQLite database and generated secret live
# (default ./data; /data in the Docker image — leave unset there)
# PLEXROUTER_DATA_DIR=./data
# Encrypts provider API keys at rest. If unset, a random one is generated
# into $PLEXROUTER_DATA_DIR/secret.key. Keep it safe: changing it makes stored
# provider keys unreadable.
PLEXROUTER_SECRET=
# Brand name shown in the console
PLEXROUTER_NAME=PlexRouter
# Create accounts for new Google/GitHub users (listed admins can always sign up)
PLEXROUTER_ALLOW_REGISTER=true
# USD credited to each new account
PLEXROUTER_SIGNUP_CREDIT=0
# Comma-separated emails that are admins. If empty, the first user to sign in is admin.
PLEXROUTER_ADMIN_EMAILS=
# Max duration of one upstream request (Go duration)
PLEXROUTER_REQUEST_TIMEOUT=10m
# Set to true behind a reverse proxy so client IPs come from X-Forwarded-For
PLEXROUTER_TRUST_PROXY=false
# debug | info | warn | error
PLEXROUTER_LOG_LEVEL=info

# Public base URL of this server, used for Google/GitHub sign-in callbacks.
# Recommended when behind a reverse proxy, e.g. https://api.example.com
# PLEXROUTER_PUBLIC_URL=

# Sign-in is only through Google and/or GitHub: configure at least one.
#
# Sign in with Google: https://console.cloud.google.com/apis/credentials
#   → OAuth client ID (Web application), redirect URI:
#   <PUBLIC_URL>/api/auth/oauth/google/callback
# PLEXROUTER_GOOGLE_CLIENT_ID=
# PLEXROUTER_GOOGLE_CLIENT_SECRET=

# Sign in with GitHub: https://github.com/settings/developers → New OAuth App,
#   Authorization callback URL: <PUBLIC_URL>/api/auth/oauth/github/callback
# PLEXROUTER_GITHUB_CLIENT_ID=
# PLEXROUTER_GITHUB_CLIENT_SECRET=

# Outbound proxy for upstream model APIs (e.g. when the server cannot reach
# api.openai.com directly)
# HTTPS_PROXY=http://127.0.0.1:7890
